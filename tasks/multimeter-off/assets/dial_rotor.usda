#usda 1.0
(
    defaultPrim = "Multimeter"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Multimeter" (
    prepend apiSchemas = ["PhysicsMassAPI"]
    prepend references = @multimeter.usda@
)
{
    float physics:mass = 0.004559

    over "Geometry"
    {
        over "cables_01_obj_00" (
            active = false
        )
        {
        }

        over "button_04_obj_00" (
            active = false
        )
        {
        }

        over "button_01_obj_00" (
            active = false
        )
        {
        }

        over "cap_01_obj_00" (
            active = false
        )
        {
        }

        over "clip_01_obj_00" (
            active = false
        )
        {
        }

        over "screen_01_obj_00" (
            active = false
        )
        {
        }

        over "button_02_obj_00" (
            active = false
        )
        {
        }

        over "cap_02_obj_00" (
            active = false
        )
        {
        }

        over "body_01_obj_00" (
            active = false
        )
        {
        }

        over "button_03_obj_00" (
            active = false
        )
        {
        }

        over "knob_01_obj_00"
        {
            over "knob_01_mesh_00" (
                prepend apiSchemas = ["PhysicsMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexDecomposition"
            }
        }
    }
}

