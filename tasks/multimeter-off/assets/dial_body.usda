#usda 1.0
(
    defaultPrim = "Multimeter"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Multimeter" (
    delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    prepend references = @multimeter.usda@
)
{
    over "Geometry"
    {
        over "knob_01_obj_00" (
            active = false
        )
        {
        }

        over "cables_01_obj_00"
        {
            over "cables_01_mesh_00" (
                prepend apiSchemas = ["PhysicsMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "none"
            }
        }

        over "button_04_obj_00"
        {
            over "button_04_mesh_00" (
                prepend apiSchemas = ["PhysicsMeshCollisionAPI"]
            )
